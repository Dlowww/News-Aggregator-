# Copy to .env (setup.sh does this for you) and fill in. Never commit .env.
# Keep comments on their own lines: Docker Compose treats text after a value as part of it.

# ---------- Required ----------
# Where the daily brief is sent
DIGEST_RECIPIENT=you@example.com
# n8n owner account (created by setup.sh). Password: 8+ chars with a number and an uppercase letter.
N8N_OWNER_EMAIL=you@example.com
N8N_OWNER_PASSWORD=
# Generated by setup.sh if empty. Back up N8N_ENCRYPTION_KEY: it encrypts stored credentials.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# ---------- Gmail OAuth (Google Cloud Console; see README "Gmail OAuth setup") ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Model (setup.sh picks OLLAMA_MODEL from your hardware if empty) ----------
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text
# To use a native (non-Docker) Ollama, e.g. on macOS for Metal acceleration:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- Optional ----------
# Alerts go to DIGEST_RECIPIENT if empty
ALERT_RECIPIENT=
# Free key from https://api.congress.gov/sign-up/ (enables Congressional Research Service reports)
CONGRESS_API_KEY=
# true = write previews/ instead of emailing (sent URLs are not recorded)
DSB_DRY_RUN=false
FEED_FAILURE_ALERT_RATIO=0.3
SCRAPER_USER_AGENT="DefenseStrategyBrief/1.0 (personal news digest; self-hosted n8n)"
N8N_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678/
N8N_IMAGE_TAG=2.46.6
OLLAMA_IMAGE_TAG=latest
POSTGRES_USER=dsb
# COMPOSE_FILE is written by setup.sh (adds docker-compose.gpu.yml when an NVIDIA GPU is usable)
