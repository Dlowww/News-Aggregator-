{
  "_comment": "Source allowlist for the Defense Strategy Brief. NOTHING outside sources with status 'approved' is ingested. Re-verify ratings monthly (the alert workflow sends a reminder). status: approved | pending_user_decision | excluded.",
  "version": "1.0.0-proposal",
  "ratings_checked_on": "2026-11-06",
  "policy": {
    "inclusion_rule": "A news outlet is approved only if at least 2 of 3 raters (AllSides, Ad Fontes Media, Media Bias/Fact Check) rate it Center/least-biased AND high factual reliability.",
    "rater_thresholds": {
      "allsides": "Bias rating 'Center' (AllSides publishes no reliability score, so a Center rating counts as one qualifying rating)",
      "adfontes": "Overall bias between -6.0 and +6.0 ('Middle') AND overall reliability >= 40.0 ('Reliable, Analysis/Fact Reporting' or higher)",
      "mbfc": "Bias 'Least Biased' AND factual reporting 'High' or 'Very High'"
    },
    "primary_source_rule": "Official U.S. government sources go in tier 'primary'. They are authoritative for what the government said or did, not neutral analysis, and the email labels them 'Primary source'. Bias raters do not cover them.",
    "corroboration": {
      "min_independent_outlets": 2,
      "primary_source_qualifies_alone": true,
      "independence_key": "owner_group",
      "_comment": "Outlets with the same owner_group count as ONE outlet when corroborating a story. Stories from a single outlet go to the 'Single-source reports' section."
    },
    "balance_flag_threshold": 0.5,
    "exclusions": {
      "url_patterns": [
        "/opinion/",
        "/opinions/",
        "/commentary/",
        "/editorial/",
        "/editorials/",
        "/op-ed/",
        "/oped/",
        "/columns/",
        "/column/",
        "/columnists/",
        "/perspective/",
        "/letters/",
        "/letters-to-the-editor/",
        "/sponsored/",
        "/sponsored-content/",
        "/partner-content/",
        "/paid-content/",
        "/brandstudio/",
        "/native/",
        "/advertorial/",
        "/podcast/",
        "/podcasts/",
        "/video/",
        "/videos/",
        "/live/",
        "/quiz/"
      ],
      "feed_categories": [
        "Opinion",
        "Opinions",
        "Commentary",
        "Editorial",
        "Editorials",
        "Op-Ed",
        "Letters",
        "Column",
        "Columns",
        "Perspective",
        "Sponsored",
        "Sponsored Content",
        "Partner Content",
        "Paid Content",
        "Podcast"
      ],
      "title_prefixes": [
        "Opinion:",
        "OPINION:",
        "Commentary:",
        "Editorial:",
        "Letter:",
        "Sponsored:"
      ]
    },
    "scraping": {
      "user_agent": "DefenseStrategyBrief/1.0 (personal news digest; self-hosted n8n)",
      "respect_robots_txt": true,
      "min_seconds_between_requests_per_host": 3,
      "max_full_text_fetches_per_run": 60,
      "never_bypass_paywalls": true,
      "fallback": "If full text is unavailable or disallowed, summarize from the feed snippet and mark the story 'based on excerpt'."
    }
  },
